# Copy to .env.local (ignored by Git) and fill in your own Supabase project values.
# The repository's .env is currently tracked: never add secrets to that file.
#
# Anything prefixed with VITE_ is bundled into the browser build and is PUBLIC.
# That is fine for the publishable (anon) key — Row Level Security is what protects
# the data, not the key. Never put a service-role key behind a VITE_ prefix.

# --- Client (bundled into the browser) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server routes (never sent to the browser) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# Bypasses Row Level Security. Set this ONLY in your hosting provider's secret
# store, never in a committed file. Leave blank locally unless you need the
# server routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPal (optional) ---
# While CLIENT_ID or CLIENT_SECRET is unset, the guest portal shows
# "online payment is not configured yet" and everything else works normally.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# --- Not required ---
# LOVABLE_CRON_SECRET / LOVABLE_CRON_SECRET_PREVIOUS are referenced only by
# src/integrations/supabase/cron-auth.ts, which nothing imports. There are no
# cron endpoints in this repository, so these are intentionally omitted rather
# than listed as blanks that look mandatory. See the README env var section.

# Public demo only: never enable on the production Vercel project.
# See docs/public-demo.md. Both Supabase URLs must be the isolated demo project.
# VITE_DEMO_MODE=true
# DEMO_MODE=true
# DEMO_LOGIN_PASSWORD=<generated by scripts/demo/provision.ts; server-only>
